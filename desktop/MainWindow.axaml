<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:CreateLauncher"
        x:Class="CreateLauncher.MainWindow" Width="1060" Height="650" MinWidth="920" MinHeight="620"
        Title="Create Launcher" Background="#172B22" WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="190,*">
    <Border Background="#11271C" BorderBrush="#293C32" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,28,18,22">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,34">
          <Image Source="avares://CreateLauncher/Assets/logo.png" Width="38" Height="38" RenderOptions.BitmapInterpolationMode="None"/>
          <TextBlock Text="CREATE" VerticalAlignment="Center" FontWeight="Bold" FontSize="17" LetterSpacing="2"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="7">
          <Button x:Name="OverviewButton" Classes="nav active" Content="{DynamicResource L0}" Click="OverviewClick"/>
          <Button x:Name="SettingsButton" Classes="nav" Content="{DynamicResource L1}" Click="SettingsClick"/>
          <Button x:Name="ClientModsButton" Classes="nav" Click="ClientModsClick">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <TextBlock Text="▦" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
              <TextBlock Text="{DynamicResource L2}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="12">
          <Button Classes="nav" Content="{DynamicResource L3}" Click="OpenGameClick"/>
          <TextBlock x:Name="LauncherVersionLabel" FontSize="10" Foreground="#6D8877" Margin="15,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="72,Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="28,0" VerticalAlignment="Center">
        <TextBlock x:Name="PageTitle" Text="Обзор" FontSize="12"/>
        <Button x:Name="AccountButton" Grid.Column="1" Padding="8,6,12,6" Background="#2B503B">
          <Grid ColumnDefinitions="34,10,*,16">
            <Border CornerRadius="5" ClipToBounds="True" Width="34" Height="34"><local:SkinHead x:Name="Avatar"/></Border>
            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="ProfileName" Text="Выбрать аккаунт" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ProfileDetail" Text="Войти в игру" FontSize="9" Foreground="#B7D9BD"/></StackPanel>
            <TextBlock Grid.Column="3" Text="▼" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Width="360" Spacing="13">
                <TextBlock Text="{DynamicResource L7}" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel x:Name="SavedProfilesSection" Spacing="8" IsVisible="False">
                  <TextBlock Text="{DynamicResource L8}" Classes="muted" FontSize="11"/>
                  <ScrollViewer MaxHeight="160"><StackPanel x:Name="SavedProfiles" Spacing="5"/></ScrollViewer>
                </StackPanel>
                <Button Content="{DynamicResource L9}" HorizontalAlignment="Stretch" Click="NewAccountClick"/>
                <StackPanel x:Name="AuthForm" Spacing="12">
                <ComboBox x:Name="AuthMode" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="AuthChanged"><ComboBoxItem Content="{DynamicResource L10}"/><ComboBoxItem Content="Ely.by"/><ComboBoxItem Content="TLauncher"/></ComboBox>
                <StackPanel Spacing="6"><TextBlock x:Name="LoginLabel" Text="Ник игрока" Classes="muted" FontSize="11"/><TextBox x:Name="Nickname" PlaceholderText="Твой ник" MaxLength="100"/></StackPanel>
                <Grid x:Name="PasswordFields" IsVisible="False" ColumnDefinitions="*,12,120">
                  <StackPanel x:Name="PasswordInputPanel" Spacing="6"><TextBlock Text="{DynamicResource L13}" Classes="muted" FontSize="11"/><TextBox x:Name="Password" PasswordChar="●" PlaceholderText="{DynamicResource L14}"/></StackPanel>
                  <StackPanel x:Name="TotpPanel" Grid.Column="2" Spacing="6"><TextBlock Text="{DynamicResource L15}" Classes="muted" FontSize="11"/><TextBox x:Name="Totp" MaxLength="6" PlaceholderText="{DynamicResource L16}"/></StackPanel>
                </Grid>
                <TextBlock x:Name="AuthHint" Text="Латинские буквы, цифры и _ · 3–16 символов" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                <TextBlock x:Name="LoginStatus" Text="" FontSize="11" TextWrapping="Wrap"/>
                <Button x:Name="SignInButton" Classes="primary" Content="Применить ник" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="SignInClick"/>
                </StackPanel>
              </StackPanel>
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
      <Border x:Name="LauncherUpdateBanner" Grid.Row="1" IsVisible="False" Classes="card" Margin="28,0,28,12" Padding="14,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="LauncherUpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
          <Button x:Name="BannerUpdateButton" Grid.Column="1" Content="{DynamicResource L19}" Click="ApplyLauncherUpdateClick"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,8,28,24">
          <StackPanel x:Name="OverviewPanel" Spacing="22">
            <StackPanel Spacing="8"><TextBlock x:Name="GreetingTitle" FontSize="29" FontWeight="SemiBold" LetterSpacing="-0.7" TextWrapping="Wrap"/><TextBlock x:Name="GreetingSubtitle" IsVisible="False" Foreground="#B4CCBC" FontSize="12" TextWrapping="Wrap"/></StackPanel>
            <Grid ColumnDefinitions="1.3*,12,*">
              <StackPanel Spacing="10">
              <Border Classes="card" Padding="16,17" MinHeight="108"><StackPanel Spacing="9"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource L20}" Classes="eyebrow" VerticalAlignment="Center"/><Button x:Name="RefreshServerButton" Grid.Column="1" Content="↻ Обновить" FontSize="10" Padding="7,3" MinHeight="0" Click="RefreshServerClick" ToolTip.Tip="{DynamicResource L22}"/></Grid><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="ServerDot" Width="7" Height="7" Fill="#C8A46E" VerticalAlignment="Center"/><TextBlock x:Name="ServerState" Text="Проверяем…" FontSize="14" FontWeight="SemiBold"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{DynamicResource L24}" Classes="muted" FontSize="11"/><TextBlock x:Name="PlayerCount" Text="— / —" FontSize="11" FontWeight="SemiBold" Foreground="#D1EDB5"/></StackPanel><TextBlock x:Name="ServerAddress" Classes="muted" FontSize="10"/></StackPanel></Border>
                <Button x:Name="BlueMapButton" Content="{DynamicResource L25}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Click="OpenBlueMapClick"/>
              </StackPanel>
              <Border Grid.Column="2" Classes="card" Padding="16,17" MinHeight="108" VerticalAlignment="Top"><StackPanel Spacing="9"><TextBlock Text="{DynamicResource L26}" Classes="eyebrow"/><TextBlock x:Name="VersionLabel" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="LoaderLabel" Classes="muted" FontSize="10"/></StackPanel></Border>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="ClientModsPanel" IsVisible="False" Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="7" Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource L27}" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.5"/>
                <TextBlock Text="{DynamicResource L28}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:Name="RefreshOptionalModsButton" Grid.Column="1" Content="{DynamicResource L29}" VerticalAlignment="Center" Click="RefreshOptionalModsClick"/>
            </Grid>
            <TextBlock x:Name="OptionalModsStatus" Classes="muted" TextWrapping="Wrap"/>
            <StackPanel x:Name="OptionalModsList" Spacing="10"/>
            <Border x:Name="OptionalModsEmpty" Classes="card" Padding="24,28">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource L30}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource L31}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPanel" IsVisible="False" Spacing="20">
            <Border Classes="card" Padding="20">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L216}" VerticalAlignment="Center"/>
                <ComboBox x:Name="LanguageSelector" Grid.Column="1" MinWidth="155" SelectionChanged="LanguageChanged">
                  <ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/>
                </ComboBox>
              </Grid>
            </Border>
            <StackPanel Spacing="7"><TextBlock Text="{DynamicResource L32}" FontSize="28" FontWeight="SemiBold" LetterSpacing="-0.5"/><TextBlock Text="{DynamicResource L33}" Foreground="#91A596" FontSize="12"/></StackPanel>
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource L34}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><NumericUpDown x:Name="MemoryInput" Minimum="2048" Maximum="16384" Increment="256" Value="6144" FormatString="0" Width="125"/><TextBlock Text="{DynamicResource L35}" VerticalAlignment="Center" Classes="muted"/></StackPanel></Grid>
                <Slider x:Name="MemorySlider" Minimum="2048" Maximum="16384" Value="6144" TickFrequency="1024" TickPlacement="BottomRight"/>
                <Canvas x:Name="MemoryScale" Height="17"/>
                <TextBlock Text="{DynamicResource L36}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="20"><StackPanel Spacing="13">
              <TextBlock Text="Java" FontSize="15" FontWeight="SemiBold"/>
              <ComboBox x:Name="JavaMode" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="JavaModeChanged"><ComboBoxItem Content="{DynamicResource L37}"/><ComboBoxItem Content="{DynamicResource L38}"/></ComboBox>
              <Grid x:Name="JavaPathPanel" IsVisible="False" ColumnDefinitions="*,12,Auto"><TextBox x:Name="JavaPathBox" PlaceholderText="{DynamicResource L39}"/><Button Grid.Column="2" Content="{DynamicResource L40}" Click="BrowseJavaClick"/></Grid>
              <TextBlock x:Name="JavaHint" Text="Java скачивается и хранится в папке лаунчера." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="{DynamicResource L42}" Click="FindJavaClick"/><Button x:Name="CheckJavaButton" Content="{DynamicResource L43}" Click="CheckJavaClick"/></StackPanel>
            </StackPanel></Border>
            <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="SettingsHint" Text="Настройки хранятся рядом с лаунчером." Classes="muted" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="primary" Content="{DynamicResource L45}" Click="SaveSettingsClick"/></Grid>
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource L46}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="LauncherUpdateStatus" Text="Проверка обновлений при запуске." Classes="muted" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="CheckLauncherUpdateButton" Content="{DynamicResource L48}" Click="CheckLauncherUpdateClick"/>
                  <Button x:Name="ApplyLauncherUpdateButton" Classes="primary" Content="{DynamicResource L49}" IsVisible="False" Click="ApplyLauncherUpdateClick"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="3" Background="#23402D" BorderBrush="#304537" BorderThickness="0,1,0,0" Padding="28,17,28,20">
        <StackPanel Spacing="13"><ProgressBar x:Name="InstallProgress" Height="3" CornerRadius="2" Maximum="100" Foreground="#A8E580" Background="#304336"/>
          <Grid ColumnDefinitions="*,Auto,12,Auto"><StackPanel VerticalAlignment="Center" Spacing="6" Margin="0,0,10,0"><TextBlock x:Name="OperationTitle" Text="Твой мир ждёт" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="OperationDetail" Text="Установи клиент и присоединяйся к серверу" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="310" HorizontalAlignment="Left"/></StackPanel><Button x:Name="InstallButton" Grid.Column="1" Content="{DynamicResource L52}" VerticalAlignment="Center" Click="InstallClick"/><Button x:Name="PlayButton" Grid.Column="3" Classes="primary" Content="Установить и играть  →" Click="PlayClick"/></Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>


